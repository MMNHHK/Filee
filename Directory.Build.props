<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>1.12.0</Version>
    <Product>格式转换器</Product>
    <Authors>Filee contributors</Authors>
    <Copyright>Copyright (c) Filee contributors</Copyright>

    <!-- Upstream: https://github.com/KnifeLemon/Filee . This build lives in the fork below: the in-app update
         check reads it, so users of this OFD-enabled build are not offered the upstream installer (which has no
         OFD support) as an "update". -->
    <FileeRepositoryUrl>https://github.com/MMNHHK/Filee</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
  </PropertyGroup>
</Project>
